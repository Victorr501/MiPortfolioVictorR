@* ── src/MiPortfolioVictorR.Client/Components/NavBar.razor ── *@
@inject NavigationManager Nav
@inject LanguageService LangService
@using MiPortfolioVictorR.Shared.Constants
@implements IDisposable

<header class="navbar">
    <nav class="navbar__inner">

        <a class="navbar__logo" href="@AppRoutes.Home">Víctor Rubín</a>

        <button class="navbar__toggle" @onclick="ToggleMenu" aria-label="Abrir menú">
            <span></span><span></span><span></span>
        </button>

        <ul class="navbar__links @(_menuOpen ? "navbar__links--open" : "")">
            <li><NavLink href="@AppRoutes.Home" Match="NavLinkMatch.All" ActiveClass="navbar__link--active" class="navbar__link">@LangService.Get("Inicio", "Home")</NavLink></li>
            <li><NavLink href="@AppRoutes.Experience" ActiveClass="navbar__link--active" class="navbar__link">@LangService.Get("Experiencia", "Experience")</NavLink></li>
            <li><NavLink href="@AppRoutes.Projects" ActiveClass="navbar__link--active" class="navbar__link">@LangService.Get("Proyectos", "Projects")</NavLink></li>
            <li><NavLink href="@AppRoutes.Education" ActiveClass="navbar__link--active" class="navbar__link">@LangService.Get("Estudios", "Education")</NavLink></li>

            <li class="navbar__separator" aria-hidden="true"></li>

            <li class="navbar__dropdown" @onmouseleave="CloseProjects" @onkeydown="HandleProjectsKey">
                <button type="button" class="navbar__dropdown-toggle" @onclick="ToggleProjects" aria-expanded="@(_projectsOpen ? "true" : "false")" aria-controls="main-projects-menu">
                    @LangService.Get("Proyectos grandes", "Main projects") <svg class="navbar__dropdown-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </button>
                <ul id="main-projects-menu" class="navbar__dropdown-menu @(_projectsOpen ? "navbar__dropdown-menu--open" : "")">
                    <li><NavLink href="@AppRoutes.Trackify" ActiveClass="navbar__dropdown-link--active" class="navbar__dropdown-link" @onclick="CloseNavigation">Trackify</NavLink></li>
                    <li><NavLink href="@AppRoutes.OperatingSystem" ActiveClass="navbar__dropdown-link--active" class="navbar__dropdown-link" @onclick="CloseNavigation">@LangService.Get("Sistema operativo (OS)", "Operating system (OS)")</NavLink></li>
                </ul>
            </li>

            <li class="navbar__separator" aria-hidden="true"></li>

            <li class="navbar__lang">
                <button class="navbar__lang-btn @(!LangService.IsEnglish ? "navbar__lang-btn--active" : "")"
                        @onclick='() => SetLang("es")'>ES</button>
                <span class="navbar__lang-sep">|</span>
                <button class="navbar__lang-btn @(LangService.IsEnglish ? "navbar__lang-btn--active" : "")"
                        @onclick='() => SetLang("en")'>EN</button>
            </li>
        </ul>

    </nav>
</header>

@code {
    private bool _menuOpen = false;
    private bool _projectsOpen = false;
    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void ToggleProjects() => _projectsOpen = !_projectsOpen;
    private void CloseProjects() => _projectsOpen = false;
    private void CloseNavigation() { _projectsOpen = false; _menuOpen = false; }
    private void HandleProjectsKey(KeyboardEventArgs args) { if (args.Key == "Escape") CloseProjects(); }

    private void SetLang(string lang)
    {
        LangService.SetLanguage(lang);
        _menuOpen = false;
        _projectsOpen = false;
    }

    protected override void OnInitialized()
    {
        LangService.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        LangService.OnLanguageChanged -= StateHasChanged;
    }
}
