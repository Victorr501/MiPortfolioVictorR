@page "/calculadora-ingenieria"
@inject LanguageService LangService
@implements IDisposable

<PageTitle>@LangService.Get("Calculadora Ingeniería", "Engineering Calculator") · Víctor Rubín Rubio</PageTitle>

<div class="page-container engineering-page">
    <section class="pfc-hero">
        <div class="pfc-hero__meta">
            <span class="badge-wood">@LangService.Get("Proyecto personal", "Personal project")</span>
            <span class="badge-wood">@LangService.Get("Fase inicial", "Early stage")</span>
        </div>
        <h1 class="pfc-hero__title">@LangService.Get("Calculadora Ingeniería", "Engineering Calculator")</h1>
        <p class="pfc-hero__desc">@LangService.Get("Una plataforma web proyectada para acercar cálculos complejos de ingeniería a las personas mediante una interfaz intuitiva y algoritmos desarrollados de forma autónoma.", "A planned web platform that makes complex engineering calculations accessible through an intuitive interface and independently developed algorithms.")</p>
        <div class="pfc-hero__links">
            <a class="btn-wood-primary" href="https://github.com/Victorr501/CalculadoraIngenieria" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a class="btn-wood-outline" href="https://drive.google.com/drive/folders/1bCi-TEtRmeICxxnqtGec9C60pAqpFuXE?usp=drive_link" target="_blank" rel="noopener noreferrer">@LangService.Get("Documento de Google Drive", "Google Drive document")</a>
        </div>
    </section>

    <section class="section">
        <div class="section__label">@LangService.Get("La idea", "The idea")</div>
        <h2 class="section__title">@LangService.Get("Ingeniería, cálculo y claridad", "Engineering, calculation and clarity")</h2>
        <div class="pfc-features">
            <div class="pfc-feature">
                <h3 class="pfc-feature__title">@LangService.Get("Cálculos especializados", "Specialized calculations")</h3>
                <p class="pfc-feature__desc">@LangService.Get("Módulos para resolver problemas de ingeniería que van más allá de una calculadora convencional.", "Modules for solving engineering problems beyond the scope of a conventional calculator.")</p>
            </div>
            <div class="pfc-feature">
                <h3 class="pfc-feature__title">@LangService.Get("Experiencia sencilla", "Simple experience")</h3>
                <p class="pfc-feature__desc">@LangService.Get("Formularios adaptados a cada cálculo y resultados presentados de forma clara.", "Forms tailored to each calculation and clearly presented results.")</p>
            </div>
            <div class="pfc-feature">
                <h3 class="pfc-feature__title">@LangService.Get("Lógica propia", "Original logic")</h3>
                <p class="pfc-feature__desc">@LangService.Get("El autor diseña, programa y valida de forma autónoma los algoritmos matemáticos.", "The author independently designs, programs and validates the mathematical algorithms.")</p>
            </div>
            <div class="pfc-feature">
                <h3 class="pfc-feature__title">@LangService.Get("Preparada para crecer", "Built to grow")</h3>
                <p class="pfc-feature__desc">@LangService.Get("Una arquitectura desacoplada permitirá incorporar nuevos módulos y preparar su despliegue en la nube.", "A decoupled architecture will allow new modules to be added and prepare the platform for cloud deployment.")</p>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section__label">Stack</div>
        <h2 class="section__title">@LangService.Get("Arquitectura prevista", "Planned architecture")</h2>
        <div class="pfc-stack">
            <div class="pfc-stack__item"><span class="pfc-stack__layer">@LangService.Get("Lógica de cálculo", "Calculation logic")</span><span class="pfc-stack__tech">@LangService.Get("Algoritmos independientes de la API y la interfaz.", "Algorithms independent of the API and user interface.")</span></div>
            <div class="pfc-stack__item"><span class="pfc-stack__layer">Backend</span><span class="pfc-stack__tech">Python · FastAPI · Pydantic · REST API</span></div>
            <div class="pfc-stack__item"><span class="pfc-stack__layer">Frontend</span><span class="pfc-stack__tech">JavaScript · React</span></div>
            <div class="pfc-stack__item"><span class="pfc-stack__layer">@LangService.Get("Infraestructura", "Infrastructure")</span><span class="pfc-stack__tech">@LangService.Get("Repositorio en GitHub · Despliegue en la nube previsto.", "GitHub repository · Cloud deployment planned.")</span></div>
        </div>
    </section>

    <section class="section">
        <div class="section__label">@LangService.Get("Autoría y colaboración", "Authorship and collaboration")</div>
        <h2 class="section__title">@LangService.Get("Del algoritmo a la web", "From algorithm to web")</h2>
        <div class="engineering-workflow">
        <blockquote class="pfc-quote">@LangService.Get("El autor desarrolla y valida cada cálculo. Después, los agentes de OpenCode integran la lógica en FastAPI y React sin alterar las fórmulas originales, bajo la supervisión del autor.", "The author develops and validates each calculation. OpenCode agents then integrate the logic into FastAPI and React without changing the original formulas, under the author's supervision.")</blockquote>
        <div class="pfc-stack">
            <div class="pfc-stack__item"><span class="pfc-stack__layer">01 · @LangService.Get("Diseño y validación", "Design and validation")</span><span class="pfc-stack__tech">@LangService.Get("El autor crea y comprueba el proceso matemático.", "The author creates and checks the mathematical process.")</span></div>
            <div class="pfc-stack__item"><span class="pfc-stack__layer">02 · @LangService.Get("Especificación", "Specification")</span><span class="pfc-stack__tech">@LangService.Get("Se documentan las entradas, el proceso y las salidas.", "Inputs, process and outputs are documented.")</span></div>
            <div class="pfc-stack__item"><span class="pfc-stack__layer">03 · @LangService.Get("Integración", "Integration")</span><span class="pfc-stack__tech">@LangService.Get("Los agentes incorporan el cálculo al backend y crean su vista.", "Agents integrate the calculation into the backend and create its view.")</span></div>
            <div class="pfc-stack__item"><span class="pfc-stack__layer">04 · @LangService.Get("Supervisión", "Review")</span><span class="pfc-stack__tech">@LangService.Get("El autor verifica la fidelidad y actualiza el estado del proyecto.", "The author verifies fidelity and updates the project status.")</span></div>
        </div>
        </div>
    </section>

    <section class="section">
        <div class="section__label">@LangService.Get("Lógica core", "Core logic")</div>
        <h2 class="section__title">@LangService.Get("Módulos de cálculo", "Calculation modules")</h2>
        <div class="pfc-stack">
            <div class="pfc-stack__item"><span class="pfc-stack__layer">@LangService.Get("Primer módulo piloto · Pendiente", "First pilot module · Pending")</span><span class="pfc-stack__tech">@LangService.Get("Por definir: problema, entradas, proceso y resultados.", "To be defined: problem, inputs, process and results.")</span></div>
        </div>
    </section>

    <section class="section">
        <div class="section__label">@LangService.Get("Próximos pasos", "Next steps")</div>
        <h2 class="section__title">@LangService.Get("Hoja de ruta", "Roadmap")</h2>
        <div class="pfc-stack">
            <div class="pfc-stack__item"><span class="pfc-stack__layer">00 · @LangService.Get("Concepto", "Concept")</span><span class="pfc-stack__tech">@LangService.Get("Visión, tecnologías y modelo de trabajo definidos.", "Vision, technologies and working model defined.")</span></div>
            <div class="pfc-stack__item"><span class="pfc-stack__layer">01 · @LangService.Get("Repositorio", "Repository")</span><span class="pfc-stack__tech">@LangService.Get("Repositorio en GitHub; estructura backend/ y frontend/ prevista.", "GitHub repository; backend/ and frontend/ structure planned.")</span></div>
            <div class="pfc-stack__item"><span class="pfc-stack__layer">02 · @LangService.Get("Arquitectura y reglas", "Architecture and rules")</span><span class="pfc-stack__tech">@LangService.Get("Documentar convenciones y flujo de trabajo para los agentes.", "Document conventions and the agents' workflow.")</span></div>
            <div class="pfc-stack__item"><span class="pfc-stack__layer">03 · @LangService.Get("Módulo piloto", "Pilot module")</span><span class="pfc-stack__tech">@LangService.Get("Integrar y validar el primer cálculo creado por el autor.", "Integrate and validate the first calculation created by the author.")</span></div>
            <div class="pfc-stack__item"><span class="pfc-stack__layer">04 · @LangService.Get("Despliegue", "Deployment")</span><span class="pfc-stack__tech">@LangService.Get("Publicar una primera versión funcional en la nube.", "Publish a first functional version in the cloud.")</span></div>
        </div>
    </section>

    <section class="section">
        <div class="section__label">@LangService.Get("Diario de desarrollo", "Development diary")</div>
        <h2 class="section__title">@LangService.Get("Actualizaciones", "Updates")</h2>
        <div class="pfc-updates">
            <article class="pfc-update">
                <time class="pfc-update__date" datetime="2026-11-25"><span class="pfc-update__day">25</span><span class="pfc-update__month">@LangService.Get("nov", "Nov")</span><span class="pfc-update__year">2026</span></time>
                <div class="pfc-update__body">
                    <h3 class="pfc-update__title">@LangService.Get("Memoria inicial del proyecto", "Initial project brief")</h3>
                    <p class="pfc-update__desc">@LangService.Get("Definición de la visión, el stack, el flujo de trabajo y la hoja de ruta.", "Defined the vision, stack, workflow and roadmap.")</p>
                </div>
            </article>
        </div>
    </section>
</div>

@code {
    protected override void OnInitialized() => LangService.OnLanguageChanged += StateHasChanged;

    public void Dispose() => LangService.OnLanguageChanged -= StateHasChanged;
}
